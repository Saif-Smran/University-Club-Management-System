    {
      "name": "Admin (System Admin Only)",
      "description": "Every endpoint here requires {{adminToken}} (system-level Admin role). Grouped separately from the resource folders below so all admin-gated actions live in one place.",
      "item": [
        {
          "name": "Student Verification",
          "description": "",
          "item": [
