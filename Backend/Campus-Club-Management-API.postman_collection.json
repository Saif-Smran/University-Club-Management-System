{
  "info": {
    "name": "Campus Club Management API",
    "description": "Generated from the provided .rest file. Folders are split by module (Auth, Student Verification, Users, Clubs, Memberships, Dashboard, Payment, Notification) for self-service/club-admin endpoints, with a separate top-level Admin folder holding every system-admin-only (adminToken) route across modules. Payment endpoints follow the Stripe spec supplied by the user. Notification endpoints were generated (not in the original .rest file) to match the existing API conventions.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
