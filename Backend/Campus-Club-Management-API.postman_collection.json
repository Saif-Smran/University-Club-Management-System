    {
      "name": "Payment",
      "description": "Stripe Checkout integration: create session, webhook confirm, customer payment history and lookup.",
      "item": [
        {
          "name": "Create Checkout Session",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/payments/create",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "payments",
                "create"
              ]
            },
            "description": "Customer only. Creates a Stripe Checkout Session for a rental order. Returns a Stripe-hosted checkout URL/session id to redirect the customer to.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"registrationId\": \"{{registrationId}}\",\n  \"amount\": 500,\n  \"currency\": \"usd\",\n  \"successUrl\": \"http://localhost:3000/payment/success\",\n  \"cancelUrl\": \"http://localhost:3000/payment/cancel\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Confirm Payment (Webhook)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/payments/confirm",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "payments",
                "confirm"
              ]
            },
            "description": "Public / Stripe webhook. Stripe calls this to confirm a completed checkout session. In production, verify the Stripe-Signature header against the raw body before trusting this payload.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"evt_1PXXXXXXXXXXXXXXXXXXXXXX\",\n  \"type\": \"checkout.session.completed\",\n  \"data\": {\n    \"object\": {\n      \"id\": \"cs_test_XXXXXXXXXXXXXXXXXXXXXXXX\",\n      \"payment_status\": \"paid\",\n      \"metadata\": {\n        \"paymentId\": \"{{paymentId}}\"\n      }\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Get My Payment History",
