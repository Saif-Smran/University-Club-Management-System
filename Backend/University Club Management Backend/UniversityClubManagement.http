  "title": "Programming Workshop",
  "description": "Introduction to ASP.NET Core.",
  "type": "Free",
  "price": null,
  "capacity": 100,
  "startTime": "2026-08-20T10:00:00Z",
  "endTime": "2026-08-20T13:00:00Z",
  "location": "Room 301"
}

