#     {
#       "id": "22222222-2222-2222-2222-222222222222",
#       "name": "Programming Club",
#       "category": "Technology"
#     }
#   ]
# }


### 4.4 Get Club By ID
GET {{baseUrl}}/api/clubs/{{clubId}}

### Expected Response
# HTTP/1.1 200 OK
#
# {
#   "success": true,
#   "data": {
#     "id": "22222222-2222-2222-2222-222222222222",
