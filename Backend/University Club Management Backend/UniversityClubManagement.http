#     "id": "11111111-1111-1111-1111-111111111111",
#     "fullName": "John Smith",
#     "email": "john@example.com",
#     "role": "Student",
#     "studentId": "2023-1-60-001"
#   }
# }


### ============================================================
### 4. CLUBS
### ============================================================


### 4.1 Apply For New Club Creation (Student / User)
POST {{baseUrl}}/api/clubs/apply
Authorization: Bearer {{studentToken}}
Content-Type: multipart/form-data; boundary=----WebKitFormBoundary

------WebKitFormBoundary
Content-Disposition: form-data; name="name"

Competitive Programming Club
------WebKitFormBoundary
Content-Disposition: form-data; name="description"

A club dedicated to algorithm challenges, LeetCode, and ICPC contests.
------WebKitFormBoundary
Content-Disposition: form-data; name="category"

Technology
------WebKitFormBoundary
Content-Disposition: form-data; name="logo"; filename="club-logo.png"
Content-Type: image/png

< ./test-files/club-logo.png
------WebKitFormBoundary--

### Expected Response
# HTTP/1.1 201 Created
#
# {
#   "success": true,
#   "message": "Club creation application submitted successfully. Pending admin approval.",
#   "data": {
#     "id": "22222222-2222-2222-2222-222222222222",
#     "name": "Competitive Programming Club",
#     "description": "A club dedicated to algorithm challenges, LeetCode, and ICPC contests.",
#     "category": "Technology",
#     "ownerId": "11111111-1111-1111-1111-111111111111",
#     "logoUrl": "https://res.cloudinary.com/tw2hejfe/image/upload/v12345/club-logos/logo.png",
#     "status": "Pending",
#     "isActive": false,
#     "createdAt": "2026-08-17T12:00:00Z"
#   }
# }


### 4.2 Get Active Approved Clubs
GET {{baseUrl}}/api/clubs?search=programming&category=Technology

### Expected Response
# HTTP/1.1 200 OK


### 4.3 Get Club By ID
GET {{baseUrl}}/api/clubs/{{clubId}}

### Expected Response
# HTTP/1.1 200 OK


### 4.4 Update Club (ClubAdmin Only)
PATCH {{baseUrl}}/api/clubs/{{clubId}}
Authorization: Bearer {{clubAdminToken}}
Content-Type: {{contentType}}

{
  "name": "Competitive Programming & AI Club",
  "description": "Updated description with AI integration."
}

### Expected Response
# HTTP/1.1 200 OK


### ============================================================
### 5. MEMBERSHIPS
### ============================================================


### 5.1 Apply To Join Club
POST {{baseUrl}}/api/clubs/{{clubId}}/apply
Authorization: Bearer {{studentToken}}


### 5.2 Approve Membership (ClubAdmin Only)
PATCH {{baseUrl}}/api/memberships/{{membershipId}}/approve
Authorization: Bearer {{clubAdminToken}}


### 5.3 Reject Membership (ClubAdmin Only)
PATCH {{baseUrl}}/api/memberships/{{membershipId}}/reject
Authorization: Bearer {{clubAdminToken}}
Content-Type: {{contentType}}

{
  "reason": "Membership requirements were not satisfied."
}


### 5.4 Leave Club
POST {{baseUrl}}/api/clubs/{{clubId}}/leave
Authorization: Bearer {{studentToken}}


