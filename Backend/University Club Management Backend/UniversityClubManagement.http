#     "studentId": "2023-1-60-001",
#     "isVerified": true,
#     "createdAt": "2026-08-17T09:00:00Z"
#   }
# }


### 3.2 Update My Profile
PATCH {{baseUrl}}/api/users/profile
Authorization: Bearer {{studentToken}}
Content-Type: {{contentType}}

{
  "fullName": "John Smith",
  "studentId": "2023-1-60-001"
}

### Expected Response
# HTTP/1.1 200 OK
#
# {
#   "success": true,
#   "message": "Profile updated successfully.",
