@baseUrl = http://localhost:5000
@contentType = application/json

### ============================================================
### VARIABLES
### ============================================================

@studentToken = YOUR_STUDENT_ACCESS_TOKEN
@clubAdminToken = YOUR_CLUB_ADMIN_ACCESS_TOKEN
@adminToken = YOUR_SYSTEM_ADMIN_ACCESS_TOKEN

@studentId = 11111111-1111-1111-1111-111111111111
@clubId = 22222222-2222-2222-2222-222222222222
@membershipId = 33333333-3333-3333-3333-333333333333
@eventId = 44444444-4444-4444-4444-444444444444
@registrationId = 55555555-5555-5555-5555-555555555555
@paymentId = 66666666-6666-6666-6666-666666666666
@announcementId = 77777777-7777-7777-7777-777777777777
@verificationId = 88888888-8888-8888-8888-888888888888

### ============================================================
### 1. AUTHENTICATION
### ============================================================


### 1.1 Register Student (No Role Field Required, Multipart Upload to Cloudinary)
POST {{baseUrl}}/api/auth/register-student
Content-Type: multipart/form-data; boundary=----WebKitFormBoundary

------WebKitFormBoundary
Content-Disposition: form-data; name="fullName"

John Doe
------WebKitFormBoundary
Content-Disposition: form-data; name="email"

john.doe@example.com
------WebKitFormBoundary
Content-Disposition: form-data; name="password"

Password123!
------WebKitFormBoundary
Content-Disposition: form-data; name="studentId"

2023-1-60-001
------WebKitFormBoundary
Content-Disposition: form-data; name="idCardImage"; filename="student-id.jpg"
Content-Type: image/jpeg

< ./test-files/student-id.jpg
------WebKitFormBoundary--

### Expected Response
# HTTP/1.1 201 Created
#
# {
#   "success": true,
#   "message": "Registration successful. Please await admin verification of your student ID photo.",
#   "data": {
#     "id": "11111111-1111-1111-1111-111111111111",
#     "fullName": "John Doe",
#     "email": "john.doe@example.com",
#     "role": "Student",
#     "studentId": "2023-1-60-001",
#     "status": "Pending"
#   }
# }


### 1.2 Login
POST {{baseUrl}}/api/auth/login
Content-Type: {{contentType}}

{
  "email": "john@example.com",
  "password": "Password123!"
}

### Expected Response
# HTTP/1.1 200 OK
#
# {
#   "success": true,
#   "message": "Login successful",
#   "data": {
#     "accessToken": "eyJhbGciOiJIUzI1NiIs...",
#     "refreshToken": "d8f4c2...",
#     "expiresIn": 900,
#     "user": {
#       "id": "11111111-1111-1111-1111-111111111111",
#       "fullName": "John Doe",
#       "email": "john@example.com",
#       "role": "Student",
#       "studentId": "2023-1-60-001",
#       "isVerified": false,
#       "verificationStatus": "Pending"
#     }
#   }
# }


### 1.3 Get Current User (Me)
GET {{baseUrl}}/api/auth/me
Authorization: Bearer {{studentToken}}

### Expected Response
# HTTP/1.1 200 OK
#
# {
#   "success": true,
#   "data": {
#     "id": "11111111-1111-1111-1111-111111111111",
#     "fullName": "John Doe",
#     "email": "john@example.com",
#     "role": "Student",
#     "studentId": "2023-1-60-001",
#     "isVerified": false,
#     "verificationStatus": "Pending"
#   }
# }


### 1.4 Refresh Token
POST {{baseUrl}}/api/auth/refresh-token
Content-Type: {{contentType}}

{
  "refreshToken": "YOUR_REFRESH_TOKEN"
}

### Expected Response
# HTTP/1.1 200 OK
#
# {
#   "success": true,
#   "message": "Token refreshed successfully",
#   "data": {
#     "accessToken": "NEW_ACCESS_TOKEN",
#     "refreshToken": "NEW_REFRESH_TOKEN",
#     "expiresIn": 900
#   }
# }


### 1.5 Logout
POST {{baseUrl}}/api/auth/logout
Authorization: Bearer {{studentToken}}

### Expected Response
# HTTP/1.1 200 OK
#
# {
#   "success": true,
#   "message": "Logged out successfully"
# }


### ============================================================
### 2. STUDENT VERIFICATION
### ============================================================


### 2.1 Upload / Re-upload Student ID Card (Cloudinary Upload)
POST {{baseUrl}}/api/student-verification/upload
Authorization: Bearer {{studentToken}}
Content-Type: multipart/form-data; boundary=----WebKitFormBoundary

------WebKitFormBoundary
Content-Disposition: form-data; name="studentId"

2023-1-60-001
------WebKitFormBoundary
Content-Disposition: form-data; name="document"; filename="student-id.jpg"
Content-Type: image/jpeg

< ./test-files/student-id.jpg
------WebKitFormBoundary--

### Expected Response
# HTTP/1.1 201 Created
#
# {
#   "success": true,
#   "message": "Student ID card uploaded successfully. Pending admin approval.",
#   "data": {
#     "id": "88888888-8888-8888-8888-888888888888",
#     "userId": "11111111-1111-1111-1111-111111111111",
#     "studentId": "2023-1-60-001",
#     "documentPath": "https://res.cloudinary.com/tw2hejfe/image/upload/v12345/student-verifications/id.jpg",
#     "status": "Pending",
#     "createdAt": "2026-08-17T10:00:00Z"
#   }
# }


### 2.2 Get My Verification Status
GET {{baseUrl}}/api/student-verification/status
Authorization: Bearer {{studentToken}}

### Expected Response
# HTTP/1.1 200 OK
#
# {
#   "success": true,
#   "data": {
#     "id": "88888888-8888-8888-8888-888888888888",
#     "userId": "11111111-1111-1111-1111-111111111111",
#     "studentId": "2023-1-60-001",
#     "documentPath": "https://res.cloudinary.com/tw2hejfe/image/upload/v12345/student-verifications/id.jpg",
#     "status": "Approved"
#   }
# }


### ============================================================
### 3. USERS MANAGEMENT
### ============================================================


### 3.1 Get My Profile
GET {{baseUrl}}/api/users/profile
Authorization: Bearer {{studentToken}}

### Expected Response
# HTTP/1.1 200 OK
#
# {
#   "success": true,
#   "data": {
#     "id": "11111111-1111-1111-1111-111111111111",
#     "fullName": "John Doe",
