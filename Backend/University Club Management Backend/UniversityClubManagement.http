#     "id": "22222222-2222-2222-2222-222222222222",
#     "name": "Programming & Technology Club",
#     "category": "Technology"
#   }
# }


### 4.6 Delete Club
DELETE {{baseUrl}}/api/clubs/{{clubId}}
Authorization: Bearer {{adminToken}}

### Expected Response
