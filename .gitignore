# =============================================================================
# Root .gitignore for University Club Management System (UCMS)
# =============================================================================

# -----------------------------------------------------------------------------
# .NET / C# Build & Compiler Artifacts
# -----------------------------------------------------------------------------
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
publish/
out/
*.user
*.userosscache
*.sln.docstates
*.suo
*.userprefs
*.userstorage
*.mono
*.apk
*.aab

# Visual Studio & VS Code
.vs/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# -----------------------------------------------------------------------------
# Node.js / React / Next.js Frontend Artifacts
# -----------------------------------------------------------------------------
node_modules/
.next/
build/
dist/
.cache/
.turbo/
.vercel/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# -----------------------------------------------------------------------------
# Environment & Sensitive Credentials
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
appsettings.Production.json
appsettings.Local.json
appsettings.Development.json

# -----------------------------------------------------------------------------
# OS & System Junk Files
# -----------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# -----------------------------------------------------------------------------
# Uploads & Temporary Media Files
# -----------------------------------------------------------------------------
uploads/
temp/
tmp/
*.tmp
